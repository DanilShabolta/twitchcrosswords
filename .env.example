# ==========================================
# Twitch Crossword Extension — .env файл
# Скопируй этот файл в .env и заполни свои данные
# ==========================================

# --- Twitch Бот ---
TWITCH_TOKEN=oauth:ВАШ_ТОКЕН_ЗДЕСЬ
TWITCH_CHANNEL=название_вашего_канала
BOT_USERNAME=CrosswordBot

# --- Сервер ---
PORT=3000

# --- HTTPS (нужен для Twitch Extension) ---
HTTPS_ENABLED=false
HTTPS_PORT=443
SSL_KEY_PATH=./ssl/key.pem
SSL_CERT_PATH=./ssl/cert.pem

# Публичный URL вашего сервера (для вывода в консоль)
PUBLIC_URL=https://ВАШ_IP_ИЛИ_ДОМЕН
